{
  "name": "sio-backend",
  "version": "1.0.0",
  "description": "Sistema de Inteligencia Operativa - API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node scripts/init-sqlite.js",
    "db:reset": "node scripts/init-sqlite.js --reset",
    "db:seed": "node scripts/seed-sqlite.js",
