# ---- Servidor ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Base de datos del SIO (lectura/escritura) ----
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SIO
DB_USER=sio_app
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_CERT=true

# ---- Conexion de SOLO LECTURA para ejecutar los KPIs (Fase 2) ----
# NO reutilizar las credenciales de arriba.
DB_RO_SERVER=localhost
DB_RO_PORT=1433
DB_RO_NAME=BD_ORIGEN
DB_RO_USER=sio_kpi_reader
DB_RO_PASSWORD=

# ---- JWT ----
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=7

# ---- Seguridad ----
BCRYPT_ROUNDS=12
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---- Correo (Fase 4) ----
MAIL_ENABLED=false
MAIL_HOST=smtp.empresa.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=SIO <no-reply@empresa.com>

# ---- Monitor de umbrales (Fase 3) ----
MONITOR_ENABLED=true
MONITOR_CRON=*/1 * * * *
PURGE_CRON=0 3 * * *
