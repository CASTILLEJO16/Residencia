# ---- Servidor ----
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Base de datos del SIO (SQLite) ----
# Ruta del archivo SQLite. Si no se especifica, se usa ./data/sio.db
DB_PATH=./data/sio.db

# ---- JWT ----
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=7

# ---- Seguridad ----
BCRYPT_ROUNDS=12
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---- LDAP / Active Directory (Produccion) ----
# Dejar LDAP_URL vacio para usar solo la autenticacion local (desarrollo).
LDAP_URL=
LDAP_BASE_DN=DC=empresa,DC=com
LDAP_DOMAIN=empresa.com
LDAP_CA_CERT=
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
LDAP_TIMEOUT_MS=5000
# Si el directorio no responde, permitir el login con cuentas locales.
# Por defecto: true en desarrollo, false con NODE_ENV=production.
LDAP_FALLBACK_LOCAL=
# Nombre de los grupos de AD que corresponden a cada rol del SIO.
AD_GROUP_ADMIN=SIO_Admin
AD_GROUP_ANALISTAS=SIO_Analistas
AD_GROUP_CONSULTA=SIO_Consulta
AD_GROUP_AUDITORIA=SIO_Auditoria

# ---- Datos demo (scripts/seed-sqlite.js) ----
# Contrasena inicial de los usuarios demo (deberan cambiarla al entrar).
SEED_PASSWORD=

# ---- Correo (Fase 4) ----
MAIL_ENABLED=false
MAIL_HOST=smtp.empresa.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=SIO <no-reply@empresa.com>

# ---- Monitor de umbrales (Fase 3) ----
MONITOR_ENABLED=true
MONITOR_CRON=*/1 * * * *
PURGE_CRON=0 3 * * *
